	partition FactDTCComparison = m
		mode: import
		source =
				let
				    Quelle = FactDTCEvents,
				    #"Zusammengeführte Abfragen" = Table.NestedJoin(Quelle, {"TestID"}, DimTestSpecification, {"TestID"}, "DimTestSpecification", JoinKind.LeftOuter),
				    #"Erweiterte DimTestSpecification" = Table.ExpandTableColumn(#"Zusammengeführte Abfragen", "DimTestSpecification", {"ExpectedDTC"}, {"ExpectedDTC"}),
				    #"Hinzugefügte benutzerdefinierte Spalte" = Table.AddColumn(#"Erweiterte DimTestSpecification", "DTCStatus", each if [ExpectedDTC] = null then
				    "No Specification Match"
				else if [ActualDTC] = [ExpectedDTC] then
				    "Expected DTC"
				else
				    "Additional DTC"),
				    #"Geänderter Typ" = Table.TransformColumnTypes(#"Hinzugefügte benutzerdefinierte Spalte",{{"DTCStatus", type text}})
				in
				    #"Geänderter Typ"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

