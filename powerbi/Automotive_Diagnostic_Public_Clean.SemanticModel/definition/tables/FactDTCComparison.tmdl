table FactDTCComparison
	lineageTag: 836e619e-a93b-40c7-932b-62fc0be86a28

	measure 'Expected DTC Events' = ```
			
			CALCULATE(
			    COUNTROWS(FactDTCComparison),
			    FactDTCComparison[DTCStatus] = "Expected DTC"
			)
			
			```
		formatString: 0
		lineageTag: ae24041c-2ae8-49c7-bcba-364f5de8633b

	measure 'Additional DTC Events' = ```
			
			CALCULATE(
			    COUNTROWS(FactDTCComparison),
			    FactDTCComparison[DTCStatus] = "Additional DTC"
			)
			
			```
		formatString: 0
		lineageTag: a15476a8-0e47-4c68-9aec-9f894a3b85a0

	measure 'No Specification Match Events' = ```
			
			CALCULATE(
			    COUNTROWS(FactDTCComparison),
			    FactDTCComparison[DTCStatus] = "No Specification Match"
			)
			
			```
		formatString: 0
		lineageTag: e1205ca1-510d-4517-af35-758387a0df3d

	measure 'Most Frequent Additional DTC' = ```
			
			VAR DTCCounts =
			    ADDCOLUMNS(
			        CALCULATETABLE(
			            VALUES(FactDTCComparison[ActualDTC]),
			            FactDTCComparison[DTCStatus] = "Additional DTC"
			        ),
			        "@Count",
			        CALCULATE(
			            COUNTROWS(FactDTCComparison),
			            FactDTCComparison[DTCStatus] = "Additional DTC"
			        )
			    )
			VAR TopDTC =
			    TOPN(
			        1,
			        DTCCounts,
			        [@Count], DESC,
			        FactDTCComparison[ActualDTC], ASC
			    )
			RETURN
			    MAXX(TopDTC, FactDTCComparison[ActualDTC])
			
			```
		lineageTag: 32c63c77-4c43-4b36-93df-eb5f41fe8b58

	measure 'Top Additional DTC Occurrences' = ```
			
			VAR TopCode = [Most Frequent Additional DTC]
			RETURN
			    CALCULATE(
			        COUNTROWS(FactDTCComparison),
			        FactDTCComparison[DTCStatus] = "Additional DTC",
			        FactDTCComparison[ActualDTC] = TopCode
			    )
			
			```
		formatString: 0
		lineageTag: 87a252c4-9727-4cb8-b018-6242292306f1

	measure 'Top Additional DTC Share' = ```
			
			DIVIDE(
			    [Top Additional DTC Occurrences],
			    [Additional DTC Events],
			    0
			)
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 5e2656ad-b7d3-43fe-8045-374e2320f2e0

